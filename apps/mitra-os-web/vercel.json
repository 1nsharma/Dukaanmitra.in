{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.dukaanmitra.in/api/v1/:path*"
    },
    {
      "source": "/ondc/:path*",
      "destination": "https://api.dukaanmitra.in/ondc/:path*"
    },
    {
      "source": "/whatsapp/:path*",
      "destination": "https://api.dukaanmitra.in/whatsapp/:path*"
    },
    {
      "source": "/webhook",
      "destination": "https://api.dukaanmitra.in/webhook"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
