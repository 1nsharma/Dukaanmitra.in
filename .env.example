
# ==============================================================================
# DukaanMitra Vercel Configuration Guide
# ==============================================================================
# Copy these values into your Vercel Dashboard under Settings > Environment Variables
# Do NOT commit your actual keys to Git.

# --- FIREBASE PUBLIC CONFIG (Get from Firebase Project Settings) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_actual_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- GENAI (Get from Google AI Studio / Gemini) ---
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# --- PAYMENTS (Get from Razorpay Dashboard) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- WHATSAPP API (Get from Meta Developers Portal) ---
WHATSAPP_API_TOKEN=your_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret
WHATSAPP_VERIFY_TOKEN=your_chosen_verify_token

# --- FIREBASE ADMIN (For Server Side Actions) ---
# This must be a single-line JSON string of your Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
