# --- FIREBASE CLIENT CONFIG (Frontend) ---
# Inhe Firebase Console > Project Settings > General > Your Apps se lein.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- FIREBASE ADMIN SDK (Backend) ---
# Vercel par "Application Default Credentials" use hote hain, lekin local dev ke liye:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}' (Single line JSON string)

# --- WHATSAPP CLOUD API ---
# Inhe developers.facebook.com > Your App > WhatsApp > Setup se lein.
WHATSAPP_API_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose
WHATSAPP_WEBHOOK_SECRET=your_app_secret_from_meta

# --- GOOGLE AI (Gemini) ---
# Inhe aistudio.google.com se lein.
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# --- MISTRAL AI (Optional Fallback) ---
# MISTRAL_API_KEY=your_mistral_api_key

# --- RAZORPAY (Subscriptions) ---
# Inhe dashboard.razorpay.com > Settings > API Keys se lein.
RAZORPAY_KEY_ID=your_razorpay_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_verification

# --- MAILGUN (Contact Form) ---
# Inhe mailgun.com dashboard se lein.
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=Support <support@yourdomain.com>
CONTACT_EMAIL_RECIPIENT=your_personal_email@gmail.com

# --- DEPLOYMENT SETTINGS ---
# Static build ke liye (GitHub Pages): set BUILD_STATIC=true
# Public only mode ke liye (Landing page only): set PUBLIC_ONLY_MODE=true
