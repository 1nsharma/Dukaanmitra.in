
{
  "entities": {
    "ContactFormSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContactFormSubmission",
      "type": "object",
      "description": "Represents a contact form submission from the website.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "submittedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "shopId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin", "staff"] },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "role", "status"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Represents a Kirana store in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "owner_name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "mrr": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" },
        "plan": { "type": "string", "enum": ["free", "basic", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "cancelled", "locked"] },
        "trial_ends_at": { "type": "string", "format": "date-time" },
        "paid_till": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "settings": {
          "type": "object",
          "properties": {
            "language": { "type": "string", "enum": ["hi", "en", "hinglish"] },
            "currency": { "type": "string" },
            "timezone": { "type": "string" },
            "allow_credit": { "type": "boolean" },
            "credit_limit_per_transaction": { "type": "number" },
            "working_hours": {
              "type": "object",
              "properties": {
                "start": { "type": "string", "format": "time" },
                "end": { "type": "string", "format": "time" }
              }
            }
          }
        }
      },
      "required": ["id", "owner_id", "name", "phone"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Represents a customer of a specific shop.",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "first_visit": { "type": "string", "format": "date-time" },
        "last_visit": { "type": "string", "format": "date-time" },
        "lastPaymentDate": { "type": "string", "format": "date-time" },
        "visit_count": { "type": "number" },
        "total_spent": { "type": "number" },
        "totalUdhaar": { "type": "number" },
        "status": { "type": "string", "enum": ["NEW", "REPEAT", "LOYAL", "churned", "blocked"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "lastReminderSentAt": { "type": "string", "format": "date-time" },
        "reminderCount": { "type": "number" }
      },
      "required": ["shop_id", "phone"]
    },
    "LedgerEntry": {
      "title": "Ledger Entry",
      "description": "Represents a single transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "item": { "type": "string" },
        "type": { "type": "string", "enum": ["credit", "payment"] },
        "source": { "type": "string", "enum": ["whatsapp", "app", "manual", "app-ai"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "raw_text": { "type": "string", "description": "The original, unmodified message text that triggered this entry." },
        "source_model_version": { "type": "string", "description": "The version of the model or parser that created this entry." },
        "source_confidence": { "type": "number", "description": "The confidence score (0-1) of the parser that created this entry." }
      },
      "required": ["id", "shop_id", "amount", "type", "customerPhone"]
    },
    "Order": {
        "title": "Order",
        "description": "Represents a payment order for a subscription.",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "shopId": { "type": "string" },
          "userId": { "type": "string" },
          "plan": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "razorpayOrderId": { "type": "string" },
          "razorpayPaymentId": { "type": "string" },
          "status": { "type": "string", "enum": ["created", "paid", "failed"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "paidAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "shopId", "userId", "plan", "amount", "razorpayOrderId", "status", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Represents a blog post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "category", "excerpt", "content", "author", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Represents a comment on a blog post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postSlug": { "type": "string" },
        "name": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postSlug", "name", "message", "createdAt"]
    },
    "Interaction": {
      "title": "Interaction Log",
      "description": "Stores every raw incoming message and the system's reaction, for auditing and AI training.",
      "type": "object",
      "properties": {
        "interactionId": { "type": "string" },
        "shop_id": { "type": "string" },
        "sender_type": { "type": "string", "enum": ["customer", "shopkeeper", "system"] },
        "sender_phone": { "type": "string" },
        "raw_message": { "type": "string" },
        "detected_intent": { "type": "string" },
        "extracted_entities": { "type": "object" },
        "system_response": { "type": "string" },
        "response_time_ms": { "type": "number" },
        "processing_status": { "type": "string", "enum": ["received", "processing", "processed", "failed"] },
        "processing_path": {
          "type": "string",
          "enum": ["deterministic", "ai_fallback"],
          "description": "The processing path taken: 'deterministic' for fast parsing, 'ai_fallback' for the full AI agent."
        },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["interactionId", "sender_phone", "created_at"]
    },
    "Log": {
      "title": "Log Entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string" },
        "details": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "event", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "type": { "type": "string", "enum": ["PAYMENT_REMINDER", "DAILY_SUMMARY", "SUBSCRIPTION_REMINDER"] },
        "sentAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "failed", "delivered", "read"] }
      },
      "required": ["id", "shopId", "customerPhone", "type", "sentAt", "status"]
    }
  },
  "auth": {
    "providers": ["google", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "schema": { "$ref": "#/entities/UserProfile" } } },
      { "path": "/shops/{shopId}", "definition": { "schema": { "$ref": "#/entities/Shop" } } },
      { "path": "/shops/{shopId}/customers/{customerPhone}", "definition": { "schema": { "$ref": "#/entities/Customer" } } },
      { "path": "/shops/{shopId}/ledger/{ledgerId}", "definition": { "schema": { "$ref": "#/entities/LedgerEntry" } } },
      { "path": "/orders/{orderId}", "definition": { "schema": { "$ref": "#/entities/Order" } } },
      { "path": "/posts/{postId}", "definition": { "schema": { "$ref": "#/entities/Post" } } },
      { "path": "/comments/{commentId}", "definition": { "schema": { "$ref": "#/entities/Comment" } } },
      { "path": "/contactFormSubmissions/{submissionId}", "definition": { "schema": { "$ref": "#/entities/ContactFormSubmission" } } },
      { "path": "/interactions/{interactionId}", "definition": { "schema": { "$ref": "#/entities/Interaction" } } },
      { "path": "/logs/{logId}", "definition": { "schema": { "$ref": "#/entities/Log" } } },
      { "path": "/notifications/{notificationId}", "definition": { "schema": { "$ref": "#/entities/Notification" } } }
    ]
  }
}
