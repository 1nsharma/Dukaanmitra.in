{
  "name": "dukaanmitra-os",
  "version": "1.0.0",
  "description": "DukaanMitra-OS: Universal Business Management & Multi-Modal AI Operating System for MSMEs",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:openwa": "docker compose -f apps/whatsapp-gateway/docker-compose.dev.yml up -d",
    "launch": "node scripts/start-production.js",
    "dev": "node scripts/start-dev.js",
    "dev:core": "npm --prefix apps/core-engine run dev",
    "dev:ai": "python -m uvicorn app:app --port 8000 --app-dir apps/ai-services",
    "dev:mitraos": "npm --prefix apps/mitra-os-web run dev",
    "dev:dukaanin": "npm --prefix apps/dukaan-in-next run dev",
    "dev:whatsapp": "npm --prefix apps/whatsapp-gateway run dev",
    "build": "npm --prefix apps/mitra-os-web install && npm --prefix apps/mitra-os-web run build",
    "build:all": "npm --prefix apps/core-engine run build && npm --prefix apps/mitra-os-web run build",
    "build:mitraos": "npm --prefix apps/mitra-os-web install && npm --prefix apps/mitra-os-web run build",
    "build:dukaanin": "npm --prefix apps/dukaan-in-next run build",
    "build:whatsapp": "npm --prefix apps/whatsapp-gateway run build",
    "start": "node apps/core-engine/dist/index.js",
    "test": "npm --prefix apps/core-engine test && node scripts/test-openwa-integration.js && node scripts/validate-deployments.js && node scripts/validate-domain-routing.js",
    "test:openwa": "node scripts/test-openwa-integration.js",
    "test:core": "npm --prefix apps/core-engine test",
    "test:mitraos": "npm --prefix apps/mitra-os-web run build && npx --prefix apps/mitra-os-web vitest run",
    "test:ondc-munim": "tsx apps/core-engine/test/ondc-munim.test.ts && python apps/ai-services/tests/test_ondc_and_whatsapp_munim.py",
    "validate:deploy": "node scripts/validate-deployments.js",
    "validate:domain": "node scripts/validate-domain-routing.js",
    "test:mowglai": "python apps/ai-services/tests/test_mowglai_delivery_agent.py"
  },
  "keywords": [
    "dukaanmitra",
    "mitraconnect",
    "msme",
    "kirana",
    "inventory",
    "ai",
    "multimodal",
    "voice",
    "ocr",
    "compliance",
    "gst",
    "openwa",
    "whatsapp",
    "superintelligence",
    "shared-brain",
    "company-entity",
    "launch-fasttrack"
  ],
  "author": "Amit Sharma / DukaanMitra Team",
  "license": "ISC",
  "workspaces": [
    "apps/mitra-os-web",
    "apps/core-engine",
    "packages/*",
    "sdks/*"
  ]
}
