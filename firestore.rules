/**
 * This ruleset establishes a multi-tenant security model for DukaanMitra.
 *
 * Core Concepts:
 * - isOwner(shopId): A helper function to verify if the requesting user owns the shop.
 *   This is the cornerstone of the multi-tenant security.
 * - User Profiles (`/users/{userId}`): Each user has a profile document. Only the user can
 *   read or write to their own profile.
 * - Shops (`/shops/{shopId}`): Any authenticated user can create a shop, but they must
 *   set themselves as the `owner_id`. Only the owner can read, update, or delete their shop.
 * - Shop Subcollections (`/shops/{shopId}/{collection}/{docId}`): All data belonging to a
 *   shop (like customers, bills, etc.) is protected by the `isOwner` function, ensuring
 *   strict data isolation between shops.
 * - Bills (`/shops/{shopId}/bills/{billId}`): Bills are made immutable to protect financial records.
 *   They can be created but never updated or deleted.
 * - Contact Forms (`/contactFormSubmissions`): Publicly writable to allow anyone to send
 *   a message, but unreadable to protect PII.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the current user is the owner of a given shop.
    function isOwner(shopId) {
      let shop = get(/databases/$(database)/documents/shops/$(shopId));
      return request.auth != null && shop.data.owner_id == request.auth.uid;
    }

    /**
     * @description
     * Allows any user to submit a contact form, but denies all read, update,
     * and delete operations to protect PII.
     */
    match /contactFormSubmissions/{contactFormSubmissionId} {
      allow get, list, update, delete: if false;
      allow create: if true;
    }

    /**
     * @description
     * A user can read and write to their own profile document. This is crucial
     * for managing their own settings and associated shopId.
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description
     * Manages access to shop documents.
     */
    match /shops/{shopId} {
      /**
       * @allow (create)
       * An authenticated user can create a new shop document. The rule enforces
       * that the `owner_id` in the new document MUST be the UID of the user
       * creating it. This securely links a shop to its owner upon creation.
       */
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;

      /**
       * @allow (read, update, delete)
       * Only the user designated as the shop's owner can read, update, or delete it.
       * This is enforced by the `isOwner` helper function.
       */
      allow read, update, delete: if isOwner(shopId);
    }
    
    /**
     * @description
     * Generic rule for all subcollections under a shop EXCEPT bills.
     * Access is granted only if the user is the owner of the parent shop.
     */
    match /shops/{shopId}/customers/{docId} {
      allow read, write: if isOwner(shopId);
    }

    /**
     * @description
     * Protects financial records by making bills immutable.
     */
    match /shops/{shopId}/bills/{billId} {
       /**
       * @allow (read, create)
       * Only the shop owner can read their bills or create new ones.
       */
      allow read, create: if isOwner(shopId);
       /**
       * @allow (update, delete)
       * Bills are immutable and cannot be changed or deleted.
       */
      allow update, delete: if false;
    }

    /**
     * @description
     * Blog posts are publicly readable. Updates are only allowed to increment
     * likes or views, one at a time, to prevent malicious writes.
     * Creation/deletion is restricted.
     */
    match /posts/{postId} {
      allow read: if true;
      allow update: if (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.views == resource.data.views + 1) && request.resource.data.diff(resource.data).affectedKeys().size() == 1;
      allow create, delete: if false;
    }

    /**
     * @description
     * Comments are publicly readable and creatable by anyone, provided the
     * required fields are present. Updates and deletes are not allowed.
     */
    match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['postSlug', 'name', 'message', 'createdAt']);
        allow update, delete: if false;
    }
  }
}
