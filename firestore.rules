/**
 * Core Philosophy: This ruleset implements a secure "dropbox" model for contact forms and
 * a user-centric model for profiles.
 *
 * Data Structure:
 * - /contactFormSubmissions: A write-only collection for public form submissions.
 * - /users: Stores user profiles, accessible only by the owning user.
 *
 * Key Security Decisions:
 * - Public Write for Contacts: `contactFormSubmissions` allows `create` from anyone to enable the public contact form. All other access is denied to protect PII.
 * - Owner-Only Access for Users: Users can only `get`, `create`, and `update` their own document in the `users` collection, keyed by their UID. This prevents users from accessing or modifying each other's data.
 * - No Data Validation: Rules focus on authorization, not data shape validation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description
     * Allows any user to submit a contact form, but denies all read, update,
     * and delete operations to protect PII.
     */
    match /contactFormSubmissions/{contactFormSubmissionId} {
      allow get, list, update, delete: if false;
      allow create: if true;
    }

    /**
     * @description
     * User profile data. Can only be read or written by the authenticated
     * user who owns the document.
     *
     * @path
     * /users/{userId}
     *
     * @allow
     * (get) An authenticated user can read their own profile.
     *
     * @allow
     * (create) An authenticated user can create their own profile document.
     *
     * @allow
     * (update) An authenticated user can update their own profile.
     *
     * @deny
     * (get) A user cannot read another user's profile.
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
