
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      // Use a hardcoded, non-guessable UID for the super admin in a real app
      // For this example, using email is okay.
      return request.auth.token.email == "amitsharma99976@gmail.com";
    }

    function isUserActive() {
      // User must be authenticated to check their profile
      if (request.auth == null) {
        return false;
      }
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Allow if doc exists and status is active.
      return userDoc.data.status == 'active';
    }

    /**
     * PUBLIC/SYSTEM COLLECTIONS
     */
    match /posts/{postId} {
      allow read: if true;
      allow update: if (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.views == resource.data.views + 1) &&
                      request.resource.data.diff(resource.data).affectedKeys().size() == 1;
      allow create, delete: if isSuperAdmin();
    }

    match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.keys().hasAll(['postSlug', 'name', 'message', 'createdAt']);
        allow update, delete: if isSuperAdmin();
    }
    
    match /contactFormSubmissions/{submissionId} {
        allow create: if true;
        allow read, update, delete: if isSuperAdmin();
    }
    
    match /interactions/{interactionId} {
        // Written by backend services, can be read by super admins for auditing.
        allow create: if true; 
        allow read: if isSuperAdmin();
        allow update, delete: if false; // Interactions should be immutable logs.
    }

    match /logs/{logId} {
        // Logs are append-only and can only be created by the backend. Super admins can read.
        allow create: if true; 
        allow read: if isSuperAdmin();
        allow update, delete: if false;
    }
    
    match /notifications/{notificationId} {
        // Notifications are written by backend only.
        allow create: if true;
        // Shop owner can read their own notifications. Super admin can read all.
        allow read: if isSuperAdmin() || 
                    (request.auth != null && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.owner_id == request.auth.uid);
        allow update, delete: if false;
    }

    /**
     * USER PROFILES
     */
    match /users/{userId} {
      // READ: Users can read their own profile. Super admins can read any profile.
      allow read: if isOwner(userId) || isSuperAdmin();
      
      // LIST: Only super admins can list users.
      allow list: if isSuperAdmin();

      // CREATE: An authenticated user can create THEIR OWN profile.
      // The role MUST be 'user' UNLESS it's the one-time super admin bootstrap.
      allow create: if isOwner(userId) &&
                     request.resource.data.status == 'active' &&
                     (
                       (request.resource.data.role == 'user') ||
                       (request.resource.data.role == 'super_admin' && request.resource.data.email == "amitsharma99976@gmail.com")
                     );

      // UPDATE: A user can update their own profile (but not role/status). A super admin can update anything.
      allow update: if isSuperAdmin() ||
                    (isOwner(userId) && resource.data.status == 'active' && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])));

      // DELETE: Only super admins can delete user profiles.
      allow delete: if isSuperAdmin();
    }
    
    /**
     * PAYMENT ORDERS
     */
    match /orders/{orderId} {
        // CREATE: A user can create their own order document.
        allow create: if request.auth.uid == request.resource.data.userId;
        // READ: A user can read their own orders. Super admins can read all.
        allow read: if isSuperAdmin() || request.auth.uid == resource.data.userId;
        // UPDATE/DELETE: Only backend with admin rights can update/delete.
        allow update, delete: if false;
    }

    /**
     * SHOPS and Subcollections
     */
    match /shops/{shopId} {
      // CREATE: Active users can create shops, and must set themselves as owner.
      allow create: if isUserActive() && request.auth != null && request.resource.data.owner_id == request.auth.uid;

      // READ: The owner (whose user profile links to this shopId) or a super admin can read.
      allow read: if isSuperAdmin() ||
          (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId == shopId);

      // UPDATE/DELETE: Only the owner of the existing document or a super admin can update/delete.
      allow update, delete: if isSuperAdmin() ||
        (request.auth != null && resource.data.owner_id == request.auth.uid);
      
       // All subcollections are protected by the same logic.
      match /{subcollection}/{docId=**} {
        // This check verifies that the person accessing the subcollection owns the parent shop.
        let isParentShopOwner = get(/databases/$(database)/documents/shops/$(shopId)).data.owner_id == request.auth.uid;

        // Super admin has full access to all subcollections
        if isSuperAdmin() {
          allow read, write: if true;
        } else {
          // Ledger entries have special immutability rules for regular users
          if subcollection == 'ledger' {
            allow update, delete: if false; // Users cannot change history
            allow read, create: if isParentShopOwner && isUserActive();
          } else {
            allow read, write: if isParentShopOwner && isUserActive();
          }
        }
      }
    }
  }
}

    