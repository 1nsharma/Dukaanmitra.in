rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userDocPath());
    }

    function userRole() {
      return hasUserDoc() ? get(userDocPath()).data.role : null;
    }

    function userShopId() {
      return hasUserDoc() ? get(userDocPath()).data.shopId : null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'super_admin' ||
        userRole() == 'super_admin'
      );
    }

    function isShopMember(shopId) {
      return signedIn() && (
        isSuperAdmin() ||
        userShopId() == shopId
      );
    }

    function isShopOwner(shopId) {
      return signedIn() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/shops/$(shopId)).data.owner_id == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isSuperAdmin();
      allow create: if isSelf(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /shops/{shopId} {
      allow read: if isShopMember(shopId);
      allow create: if signedIn() && (
        isSuperAdmin() ||
        request.resource.data.owner_id == request.auth.uid
      );
      allow update, delete: if isShopOwner(shopId);

      match /customers/{customerId} {
        allow read, create, update, delete: if isShopMember(shopId);
      }

      match /ledger/{ledgerId} {
        allow read, create, update, delete: if isShopMember(shopId);
      }
    }

    match /orders/{orderId} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /interactions/{interactionId} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.shop_id == userShopId());
      allow create: if signedIn();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, create, update: if isSuperAdmin() || (signedIn() && resource.data.shopId == userShopId());
      allow delete: if false;
    }

    match /globalMetrics/{documentId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /contactFormSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
